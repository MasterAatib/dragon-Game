{
  "format_version": "1.12.0",
  "minecraft:entity": {
    "description": {
      "identifier": "s3xta:fogo",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball"
    },
    "component_groups": {
      "wesl3y:despawn":{
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:despawn": {
        "filters": {
          "all_of":[{ "test": "distance_to_nearest_player", "operator": ">", "value": 32 }]
        }
      },
      "minecraft:type_family": {
        "family": [ "attack", "inanimate" ]
      },
        "minecraft:projectile": {
          "on_hit": {
            "impact_damage": {
              "damage": 150,
              "knockback": true,
              "semi_random_diff_damage":false,
              "destroy_on_hit": false,
              "catch_fire": true
            },
            "stick_in_ground": {},
            "definition_event": {
              "affect_projectile": true,
              "eventTrigger": {
                "event": "wesl3y:despawn",
                "target": "self" 
              }
            }
          },
          "gravity": 0.01,
          "angle_offset": 0.0,
          "inertia": 1,
          "knockback":false,
          "liquid_inertia": 0.0,
          "offset": [0, 0, 0],
          "uncertaintyBase": 10
        },
	  "minecraft:timer": {
	    "looping": true,
		"time": 7.0,
		"time_down_event": {
		  "event": "wesl3y:despawn"
		}
	  }
    },

    "events": {
      "wesl3y:despawn":{
        "queue_command": {
          "command": [
            "fill ~-1~-1~-1 ~1~1~1 fire replace air"
          ]
        },
        "add":{
          "component_groups":["wesl3y:despawn"]
        }
      }
    }
  }
}