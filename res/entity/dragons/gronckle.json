        "default": "geometry.gronckle",
        "baby": "geometry.baby_gronckle"
      },
      "animations": {
        "main_controller": "controller.animation.gronckle.main",
        "walk": "animation.gronckle.walk",
        "idle": "animation.gronckle.idle",
        "fly": "animation.gronckle.fly",
        "air_idle": "animation.gronckle.air_idle",
