        "cyan": "textures/entity/gronckle/cyan",
        "lime": "textures/entity/gronckle/lime",
        "red": "textures/entity/gronckle/red",
        "amethyst": "textures/entity/gronckle/amethyst",
        "ice": "textures/entity/gronckle/ice",
        "zombie": "textures/entity/gronckle/zombie",
        "baby_brown": "textures/entity/gronckle/baby_brown",
        "baby_orange": "textures/entity/gronckle/baby_orange",
        "baby_green": "textures/entity/gronckle/baby_green",
