        "animate": [
          "main_controller",
          "look_at_target",
          {
            "rotate": "query.property('httyd:flight_state')=='flying'&&query.ground_speed>0.1"
          }
        ]
      },
      "render_controllers": [
        "controller.render.gronckle"
      ],
      "spawn_egg": {
