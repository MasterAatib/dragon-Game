{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.death_song.main": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walking": "query.property('httyd:flight_state')=='on_ground'&&query.is_moving"
            },
            {
              "sitting": "query.is_riding || query.property('httyd:sitting') || query.property('httyd:sitting')"
            },
            {
              "gliding": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed<0&&query.ground_speed>0.5"
            },
            {
              "hovering": "query.property('httyd:flight_state')=='flying'&&query.ground_speed<0.5"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed>=0&&query.ground_speed>0.5"
            }
          ],
          "blend_transition": 1
        },
        "sitting": {
          "animations": [
            "sit"
          ],
          "transitions": [
            {
              "default": "!query.property('httyd:sitting')"
            }
          ],
          "blend_transition": 1
        },
        "walking": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "default": "query.property('httyd:flight_state')=='on_ground'&&!query.is_moving"
            },
            {
              "gliding": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed<0&&query.ground_speed>0.5"
            },
            {
              "hovering": "query.property('httyd:flight_state')=='flying'&&query.ground_speed<0.5"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed>=0&&query.ground_speed>0.5"
            }
          ],
          "blend_transition": 1
        },
        "flying": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "walking": "query.property('httyd:flight_state')=='on_ground'&&query.is_moving"
            },
            {
              "hovering": "query.property('httyd:flight_state')=='flying'&&query.ground_speed<0.5"
            },
            {
              "gliding": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed<0&&query.ground_speed>0.5"
            },
            {
              "default": "query.property('httyd:flight_state')=='on_ground'&&!query.is_moving"
            }
          ],
          "blend_transition": 2
        },
        "gliding": {
          "animations": [
            "glide"
          ],
          "transitions": [
            {
              "walking": "query.property('httyd:flight_state')=='on_ground'&&query.is_moving"
            },
            {
              "default": "query.property('httyd:flight_state')=='on_ground'&&!query.is_moving"
            },
            {
              "hovering": "query.property('httyd:flight_state')=='flying'&&query.ground_speed<0.5"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed>=0&&query.ground_speed>0.5"
            }
          ],
          "blend_transition": 1
        },
        "hovering": {
          "animations": [
            "hover"
          ],
          "transitions": [
            {
              "walking": "query.property('httyd:flight_state')=='on_ground'&&query.is_moving"
            },
            {
              "gliding": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed<0&&query.ground_speed>0.5"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'&&query.vertical_speed>=0&&query.ground_speed>0.5"
            },
            {
              "default": "query.property('httyd:flight_state')=='on_ground'&&!query.is_moving"
            }
          ],
          "blend_transition": 2
        }
      }
    }
  }
}