{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.speed_stinger.main": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle_controller"
          ],
          "transitions": [
            {
              "sitting": "query.property('httyd:sitting')"
            },
            {
              "walking": "query.is_moving"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        },
        "sitting": {
          "animations": [
            "sit"
          ],
          "transitions": [
            {
              "default": "!query.property('httyd:sitting')"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        },
        "walking": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "default": "!query.is_moving"
            },
            {
              "running": "query.ground_speed>0.7&&query.is_moving"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        },
        "running": {
          "animations": [
            "run"
          ],
          "transitions": [
            {
              "default": "!query.is_moving"
            },
            {
              "walking": "query.ground_speed<=0.7&&query.is_moving"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        }
      }
    },
    "controller.animation.speed_stinger.sniff": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "sniff": "query.is_sniffing"
            }
          ]
        },
        "sniff": {
          "animations": [
            "sniff"
          ],
          "transitions": [
            {
              "default": "!query.is_sniffing"
            }
          ]
        }
      }
    },
    "controller.animation.speed_stinger.idle": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "idle_basic": "math.random_integer(0,10) != 1"
            },
            {
              "idle_special": "math.random_integer(0,1) == 1"
            }
          ]
        },
        "idle_basic": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "default": "query.any_animation_finished"
            }
          ],
          "blend_transition": 1
        },
        "idle_special": {
          "animations": [
            "idle_special"
          ],
          "transitions": [
            {
              "default": "query.any_animation_finished"
            }
          ],
          "blend_transition": 1
        }
      }
    },
    "controller.animation.speed_stinger.attack": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "attacking": "query.is_delayed_attacking"
            }
          ]
        },
        "attacking": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "idle": "!query.is_delayed_attacking"
            }
          ]
        }
      }
    },
    "controller.animation.speed_stinger.baby": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "baby_idle"
          ],
          "transitions": [
            {
              "walking": "query.is_moving"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        },
        "walking": {
          "animations": [
            "baby_walk"
          ],
          "transitions": [
            {
              "default": "!query.is_moving"
            },
            {
              "running": "query.ground_speed>0.7&&query.is_moving"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        },
        "running": {
          "animations": [
            "baby_run"
          ],
          "transitions": [
            {
              "default": "!query.is_moving"
            },
            {
              "walking": "query.ground_speed<=0.7&&query.is_moving"
            }
          ],
          "blend_transition": 1,
          "blend_via_shortest_path": true
        }
      }
    }
  }
}