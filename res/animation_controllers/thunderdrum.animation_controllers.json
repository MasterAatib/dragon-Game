{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.thunderdrum.main": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "sitting": "query.is_riding||query.property('httyd:sitting')"
            },
            {
              "swimming": "query.is_in_water&&query.is_moving"
            },
            {
              "walking": "query.property('httyd:flight_state')=='on_ground'&&query.is_moving"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'&&query.ground_speed>0.5"
            }
          ],
          "blend_transition": 0.5
        },
        "sitting": {
          "animations": [
            "sit"
          ],
          "transitions": [
            {
              "default": "!query.is_riding&&!query.property('httyd:sitting')"
            }
          ],
          "blend_transition": 0.5
        },
        "swimming": {
          "animations": [
            "swim"
          ],
          "transitions": [
            {
              "default": "!query.is_in_water||!query.is_moving"
            }
          ],
          "blend_transition": 0.5
        },
        "hovering": {
          "animations": [
            "hover"
          ],
          "transitions": [
            {
              "default": "query.property('httyd:flight_state')=='on_ground'"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'&&query.is_moving"
            }
          ],
          "blend_transition": 0.5
        },
        "walking": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "default": "query.property('httyd:flight_state')=='on_ground'&&!query.is_moving"
            },
            {
              "flying": "query.property('httyd:flight_state')=='flying'"
            }
          ],
          "blend_transition": 0.5
        },
        "flying": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "walking": "query.property('httyd:flight_state')=='on_ground'&&query.is_moving"
            },
            {
              "default": "query.property('httyd:flight_state')=='on_ground'&&!query.is_moving"
            },
            {
              "hovering": "query.property('httyd:flight_state')=='flying'&&!query.is_moving"
            }
          ],
          "blend_transition": 0.5
        }
      }
    },
    "controller.animation.thunderdrum.attack": {
      "initial_state": "none",
      "states": {
        "none": {
          "animations": [
            "none"
          ],
          "transitions": [
            {
              "roaring": "query.is_roaring"
            }
          ]
        },
        "roaring": {
          "animations": [
            "roar"
          ],
          "transitions": [
            {
              "none": "!query.is_roaring"
            }
          ]
        }
      }
    }
  }
}