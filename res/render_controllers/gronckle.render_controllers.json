{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.gronckle": {
      "part_visibility": [
        {
          "saddleBags": "query.property('httyd:has_saddle_bag')"
        },
        {
          "equipement": "query.property('httyd:has_saddle')"
        }
      ],
      "geometry": "array.geo[query.is_baby]",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Array.baby[query.variant] : Array.adult[query.variant]"
      ],
      "arrays": {
        "geometries": {
          "Array.geo": [
            "Geometry.default",
            "Geometry.baby"
          ]
        },
        "textures": {
          "Array.adult": [
            "Texture.default",
            "Texture.default",
            "Texture.orange",
            "Texture.green",
            "Texture.pink",
            "Texture.purple",
            "Texture.black",
            "Texture.cyan",
            "Texture.lime",
            "Texture.red",
            "Texture.amethyst",
            "Texture.ice",
            "Texture.zombie"
          ],
          "Array.baby": [
            "Texture.baby_brown",
            "Texture.baby_brown",
            "Texture.baby_orange",
            "Texture.baby_green",
            "Texture.baby_pink",
            "Texture.baby_purple",
            "Texture.baby_black",
            "Texture.baby_cyan",
            "Texture.baby_lime",
            "Texture.baby_red",
            "Texture.baby_amethyst",
            "Texture.baby_ice"
          ]
        }
      }
    }
  }
}