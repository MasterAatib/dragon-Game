{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.nightmare_fire": {
      "geometry": "Geometry.fire",
      "part_visibility": [
        {
          "*": "query.property('httyd:on_fire')"
        }
      ],
      "materials": [
        {
          "*": "Material.fire"
        }
      ],
      "textures": [
        "Texture.fire"
      ],
      "overlay_color": {
        "r": 1.0,
        "g": 1.0,
        "b": 1.0,
        "a": 1.0
      },
      "uv_anim": {
        "offset": [
          "(query.property('httyd:on_fire')) ? (Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.01 : 0.0",
          "(query.property('httyd:on_fire')) ? (Math.floor(query.life_time * 20.0) + query.frame_alpha) * 0.01 : 0.0"
        ],
        "scale": [
          1.0,
          1.0
        ]
      },
      "light_color_multiplier": 0.5,
      "ignore_lighting": true
    }
  }
}