{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.hobblegrunt": {
      "part_visibility": [
        {
          "saddleBags": "query.property('httyd:has_saddle_bag')"
        },
        {
          "equipement": "query.property('httyd:has_saddle')"
        }
      ],
      "geometry": "geometry.default",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "texture.default"
      ]
    }
  }
}