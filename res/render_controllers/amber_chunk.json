{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.amber_chunk": {
      "geometry": "Array.geo[query.property('httyd:size')]",
      "arrays": {
        "geometries": {
          "Array.geo": [
            "Geometry.small",
            "Geometry.medium",
            "Geometry.large"
          ]
        },
        "textures": {
          "Array.texture": [
            "texture.default",
            "texture.gel"
          ]
        }
      },
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "textures": [
        "Array.texture[query.property('httyd:has_gel')]"
      ]
    }
  }
}