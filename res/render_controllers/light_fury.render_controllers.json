{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.light_fury": {
      "part_visibility": [
        {
          "saddleBags": "query.property('httyd:has_saddle_bag')"
        },
        {
          "equipement": "query.property('httyd:has_saddle')"
        }
      ],
      "geometry": "array.geo[query.is_baby]",
      "materials": [
        {
          "*": "material.default"
        }
      ],
      "arrays": {
        "geometries": {
          "Array.geo": [
            "Geometry.default",
            "Geometry.baby"
          ]
        }
      },
      "textures": [
        "query.is_baby ? Texture.baby : Texture.default"
      ]
    }
  }
}